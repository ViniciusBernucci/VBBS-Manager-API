# Copie este arquivo para .env e preencha os valores
# O arquivo .env nunca deve ser commitado

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=vbbs_manager_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# ── JWT ─────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres — gere com: openssl rand -base64 48
JWT_SECRET=change_me_use_at_least_32_chars_here

# ── Hotmart API ──────────────────────────────────────────────────────────────
# Credenciais OAuth 2.0 (Client Credentials) — painel Hotmart > Ferramentas > Credenciais
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=

# ── Meta Ads API ─────────────────────────────────────────────────────────────
# System User Token de longa duração (não expira) — ver instruções abaixo
# Passos: business.facebook.com > Configurações > Usuários do sistema
#   1. Crie um System User com função "Analista"
#   2. Atribua o Ativo "Conta de anúncios" com permissão "Visualizar desempenho"
#   3. Gere um token com os escopos: ads_read, ads_management, business_management
#   4. Cole o token gerado aqui (não expira, diferente do token pessoal)
FACEBOOK_TOKEN=

# ID da conta de anúncios — Gerenciador de Anúncios > canto superior esquerdo
# Formato sem "act_" (o código adiciona automaticamente)
FACEBOOK_AD_ACCOUNT_ID=

# Versão da API Graph — manter v25.0 (atual estável)
FACEBOOK_API_VERSION=v25.0

# ── ASP.NET Core ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── pgAdmin (apenas local) ──────────────────────────────────────────────────
PGADMIN_EMAIL=admin@vbbs.dev
PGADMIN_PASSWORD=admin
