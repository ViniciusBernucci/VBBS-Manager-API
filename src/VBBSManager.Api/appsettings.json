{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=vbbs_manager;Username=postgres;Password=${POSTGRES_PASSWORD}"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}",
    "Issuer": "vbbs-manager",
    "Audience": "vbbs-manager-web",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
